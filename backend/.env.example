# Copia este archivo a .env (gitignored) y ajusta los valores localmente.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Si no se define, cae a SQLite local automáticamente (ver config/settings.py).
# En Railway, la variable DATABASE_URL la provee el addon de Postgres.
# DATABASE_URL=postgres://usuario:password@host:puerto/nombre_db

CORS_ALLOWED_ORIGINS=http://localhost:5183

# Solo hace falta en producción -- ver config/settings.py, se usa para
# derivar ALLOWED_HOSTS/CORS del dominio público real del frontend. En
# local no hace falta (cae al default http://localhost:5183).
# FRONTEND_URL=https://tu-frontend.up.railway.app

# Credenciales de Cloudflare R2 (S3-compatible) para subir evidencia.
# Son opcionales en desarrollo: sin ellas, la evidencia se guarda en
# backend/media/. En producción deben configurarse las tres y el bucket.
# STORAGE_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET_NAME=rutas-evidencias
